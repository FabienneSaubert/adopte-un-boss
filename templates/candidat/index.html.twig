{% extends 'base.html.twig' %}

{% block title %}Candidat index{% endblock %}

{% block body %}
    <h1>Candidat index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Profil_visible</th>
                <th>Infos_visibles</th>
                <th>Uuid</th>
                <th>Cv</th>
                <th>Niveau_etude</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for candidat in candidats %}
            <tr>
                <td>{{ candidat.id }}</td>
                <td>{{ candidat.profilVisible ? 'Yes' : 'No' }}</td>
                <td>{{ candidat.infosVisibles ? 'Yes' : 'No' }}</td>
                <td>{{ candidat.uuid }}</td>
                <td>{{ candidat.cv }}</td>
                <td>{{ candidat.niveauEtude }}</td>
                <td>
                    <a href="{{ path('app_candidat_show', {'id': candidat.id}) }}">show</a>
                    <a href="{{ path('app_candidat_edit', {'id': candidat.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_candidat_new') }}">Create new</a>
{% endblock %}
