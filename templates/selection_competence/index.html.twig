{% extends 'base.html.twig' %}

{% block title %}SelectionCompetence index{% endblock %}

{% block body %}
    <h1>SelectionCompetence index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Coeff_competence</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for selection_competence in selection_competences %}
            <tr>
                <td>{{ selection_competence.id }}</td>
                <td>{{ selection_competence.coeffCompetence }}</td>
                <td>
                    <a href="{{ path('app_selection_competence_show', {'id': selection_competence.id}) }}">show</a>
                    <a href="{{ path('app_selection_competence_edit', {'id': selection_competence.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_selection_competence_new') }}">Create new</a>
{% endblock %}
